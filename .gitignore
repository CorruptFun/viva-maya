node_modules/
dist/
dev-dist/
.DS_Store
*.local
# Local Supabase / build env (the VITE_SUPABASE_* keys). *.local already covers .env.local;
# these guard a bare .env / .env.production so keys are never committed by accident.
.env
.env.*
# Local agent state stays out; the versioned skills (.claude/skills/) ship with the repo.
# `.claude/*` + negation (not `.claude/`): git cannot re-include children of an ignored DIRECTORY,
# so the directory itself must not match — only its non-skills contents.
.claude/*
!.claude/skills/
